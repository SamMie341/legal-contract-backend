// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ENUMS (ค่าคงที่ในระบบ)
// ==========================================

/// บทบาทผู้ใช้งานหลักในระบบ (อ้างอิงตามข้อกำหนดข้อ 2, 3, 4, 5)
enum UserRole {
  ADMIN // ผู้ดูแลระบบสูงสุด (ทำได้ทุกอย่าง + ดาวน์โหลดไฟล์ได้)
  MAIN_USER // User หลักของแผนก (อัปโหลด, แก้ไข, ลบ และได้รับอนุญาตให้ดาวน์โหลดสัญญาได้)
  EDITOR // ผู้ใช้งานที่มีสิทธิ์อัปโหลด/แก้ไขข้อมูลตามที่ได้รับมอบหมาย
  VIEWER // ผู้ใช้งานที่จำกัดสิทธิ์ให้ดูข้อมูล (View) ได้เท่านั้น
}

/// สกุลเงินที่ระบบรองรับ 3 สกุล (ກີບ, USD ແລະ Yuan)
enum Currency {
  LAK // ກີບ (Lao Kip)
  USD // ໂດລາສະຫະລັດ (US Dollar)
  CNY // ຢວນ (Chinese Yuan - RMB)
}

/// สถานะของสัญญา (ใช้สำหรับกรองข้อมูลและแสดงผลบน Dashboard)
enum ContractStatus {
  DRAFT // ฉบับร่าง
  ACTIVE // มีผลบังคับใช้ปกติ
  EXPIRING_SOON // ใกล้สิ้นสุดสัญญา (เข้าเกณฑ์ <= 60 วัน)
  EXPIRED // สิ้นสุดสัญญาแล้ว
  TERMINATED // ยกเลิกสัญญาก่อนกำหนด
}

/// ประเภทการกระทำในระบบสำหรับเก็บ Audit Log
enum AuditAction {
  CREATE_CONTRACT
  UPDATE_CONTRACT
  DELETE_CONTRACT
  UPLOAD_ATTACHMENT
  DOWNLOAD_ATTACHMENT
  DELETE_ATTACHMENT
  USER_PERMISSION_CHANGE
}

/// สถานะของการแจ้งปัญหา/ปรับปรุงระบบ (ข้อ 6)
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// ระดับความสำคัญของปัญหาที่แจ้ง
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// 2. USER & ACCESS CONTROL (ระบบผู้ใช้งานและสิทธิ์)
// ==========================================

model User {
  id           String  @id @default(uuid()) @db.Uuid
  employeeCode String? @unique @map("employee_code")
  username     String  @unique
  email        String  @unique
  passwordHash String  @map("password_hash")
  fullName     String  @map("full_name")
  department   String?
  division     String?
  unit         String?
  position     String?
  phone        String?

  // บทบาทหลัก
  role UserRole @default(VIEWER)

  // Fine-grained Permissions (ข้อ 3, 4, 5: กำหนดสิทธิ์รายบุคคลเพิ่มเติมจาก Role ได้)
  canView     Boolean @default(true) @map("can_view") // ข้อ 4: ดูข้อมูลอย่างเดียว
  canUpload   Boolean @default(false) @map("can_upload") // ข้อ 3: สิทธิ์อัปโหลดสัญญา
  canEdit     Boolean @default(false) @map("can_edit") // ข้อ 3: สิทธิ์แก้ไขข้อมูลที่กรอก
  canDelete   Boolean @default(false) @map("can_delete") // ข้อ 3: สิทธิ์ลบสัญญาในระบบ
  canDownload Boolean @default(false) @map("can_download") // ข้อ 5: สิทธิ์ดาวน์โหลดไฟล์สัญญา (เฉพาะ Admin หรือ User หลักที่ได้รับอนุญาต)

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz() // รองรับ Soft Delete เวลาลบบัญชี User

  // Relations
  createdContracts      Contract[]             @relation("ContractCreator")
  updatedContracts      Contract[]             @relation("ContractUpdater")
  uploadedAttachments   ContractAttachment[]   @relation("AttachmentUploader")
  downloadLogs          ContractDownloadLog[]
  notifications         ContractNotification[]
  auditLogs             AuditLog[]
  createdSupportTickets SupportTicket[]        @relation("TicketReporter")
  assignedTickets       SupportTicket[]        @relation("TicketAssignee")

  @@index([role, isActive])
  @@map("users")
}

// ==========================================
// 3. CONTRACT MANAGEMENT (ข้อมูลสัญญา 14 ประเภท)
// ==========================================

/// ตารางประเภทสัญญา (รองรับ 14 ประเภทหลักตามเอกสาร และเพิ่มในอนาคตได้)
model ContractType {
  id        Int      @id @default(autoincrement())
  nameLo    String   @unique @map("name_lo") // ชื่อประเภทภาษาลาวตามเอกสาร
  nameEn    String?  @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  contracts Contract[]

  @@map("contract_types")
}

/// ตารางหลักสำหรับจัดเก็บข้อมูลสัญญา (ครบทุกคอลัมน์ใน Excel)
model Contract {
  id String @id @default(uuid()) @db.Uuid

  // 1. ຊື່ສັນຍາ (กรอกข้อมูลด้วยมือ)
  title String

  // 2. ປະເພດສັນຍາ (เลือกตาม 14 ประเภทสัญญา)
  contractTypeId Int          @map("contract_type_id")
  contractType   ContractType @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)

  // 3. ເລກທີ (เลขที่สัญญา - กรอกข้อมูลด้วยมือ)
  contractNumber String @map("contract_number")

  // 4. ອາຍຸສັນຍາ (กรอกข้อมูลด้วยมือ เช่น "5 ປີ", "24 ເດືອນ" พร้อมเก็บจำนวนปี/เดือนเผื่อคำนวณ)
  durationText   String? @map("duration_text")
  durationMonths Int?    @map("duration_months")

  // 5. ມື້ລົງລາຍເຊັນ (เลือกจากปฏิทิน)
  signedDate DateTime? @map("signed_date") @db.Date

  // 6. ມື້ມີຜົນບັງຄັບໃຊ້ (เลือกจากปฏิทิน)
  effectiveDate DateTime? @map("effective_date") @db.Date

  // 7. ມື້ສີ້ນສຸດ (เลือกจากปฏิทิน - ใช้คำนวณแจ้งเตือนล่วงหน้า 60 วัน)
  expirationDate DateTime? @map("expiration_date") @db.Date

  // 8. ມູນຄ່າ & ສະກຸນເງິນ (เลือก 3 สกุล: ກີບ, USD, Yuan)
  contractValue Decimal? @map("contract_value") @db.Decimal(20, 2)
  currency      Currency @default(LAK)

  // 9. ສັດສ່ວນຫຸ້ນ ຫຼື ຈຳນວນເງິນ ປະກອບທຶນ (กรอกข้อมูลด้วยมือ - รองรับทั้งข้อความ % และตัวเลข)
  equityOrCapitalContribution String?  @map("equity_or_capital_contribution")
  sharePercentage             Decimal? @map("share_percentage") @db.Decimal(5, 2) // ฟิลด์เสริมเผื่อใช้คำนวณบน Dashboard

  // 10. ຜູ້ຈັດຕັ້ງປິຕິບັດ (ผู้จัดตั้งปฏิบัติ / หน่วยงานรับผิดชอบ - กรอกข้อมูลด้วยมือ)
  implementer String?

  // 11. ລາຍລະອຽດເພີ່ມເຕີມ (กรอกข้อมูลด้วยมือ)
  additionalDetails String? @map("additional_details")

  // ฟิลด์ควบคุมสถานะและการแจ้งเตือน 60 วัน (ข้อ 1 และ ข้อ 7 Dashboard)
  status           ContractStatus @default(ACTIVE)
  notifyDaysBefore Int            @default(60) @map("notify_days_before") // แจ้งเตือนก่อนสิ้นสุด 60 วัน
  isExpiryNotified Boolean        @default(false) @map("is_expiry_notified") // เช็คว่าแจ้งเตือนรอบ 60 วันไปแล้วหรือยัง
  lastNotifiedAt   DateTime?      @map("last_notified_at") @db.Timestamptz()

  // ข้อมูลผู้สร้างและแก้ไขสัญญา
  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation("ContractCreator", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("ContractUpdater", fields: [updatedById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz() // Soft Delete ป้องกันข้อมูลหายถาวร

  // Relations
  attachments   ContractAttachment[]
  notifications ContractNotification[]
  downloadLogs  ContractDownloadLog[]
  auditLogs     AuditLog[]

  // Indexes สำหรับเพิ่มความเร็วในการทำ Dashboard และ Cron Job แจ้งเตือน 60 วัน
  @@index([contractTypeId])
  @@index([contractNumber])
  @@index([expirationDate, status])
  @@index([status])
  @@index([currency])
  @@index([deletedAt])
  @@map("contracts")
}

// ==========================================
// 4. ATTACHMENTS & DOWNLOAD SECURITY (ข้อ 3 และ ข้อ 5)
// ==========================================

/// ตารางเก็บไฟล์เอกสารสัญญาที่อัปโหลดเข้าระบบ
model ContractAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  fileName   String  @map("file_name") // ชื่อไฟล์เดิม
  storageKey String  @map("storage_key") // Path หรือ Key ใน S3 / MinIO / Local Storage
  mimeType   String  @map("mime_type") // เช่น application/pdf
  fileSize   BigInt  @map("file_size") // ขนาดไฟล์ (Bytes)
  checksum   String? // SHA-256 ป้องกันไฟล์เสียหาย
  version    Int     @default(1) // รองรับกรณีอัปโหลดไฟล์สัญญาฉบับแก้ไข

  uploadedById String    @map("uploaded_by_id") @db.Uuid
  uploadedBy   User      @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  // Relations
  downloadLogs ContractDownloadLog[]

  @@index([contractId])
  @@map("contract_attachments")
}

/// ตารางบันทึกประวัติการดาวน์โหลดไฟล์สัญญา (ตรวจสอบสิทธิ์ตามข้อ 5)
model ContractDownloadLog {
  id           String             @id @default(uuid()) @db.Uuid
  contractId   String             @map("contract_id") @db.Uuid
  contract     Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  attachmentId String             @map("attachment_id") @db.Uuid
  attachment   ContractAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  userId       String             @map("user_id") @db.Uuid
  user         User               @relation(fields: [userId], references: [id])

  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  downloadedAt DateTime @default(now()) @map("downloaded_at") @db.Timestamptz()

  @@index([contractId])
  @@index([userId, downloadedAt])
  @@map("contract_download_logs")
}

// ==========================================
// 5. NOTIFICATIONS (ข้อ 1: แจ้งเตือนก่อนสัญญาสิ้นสุด 60 วัน)
// ==========================================

/// ตารางแจ้งเตือนในระบบเมื่อสัญญาใกล้ครบกำหนด 60 วัน (หรือครบกำหนดแล้ว)
model ContractNotification {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id") @db.Uuid // หากเป็น null คือแจ้งเตือนส่วนกลางของแผนก
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  message       String
  daysRemaining Int       @map("days_remaining") // เช่น เหลืออีก 60 วัน, 30 วัน, 7 วัน
  isRead        Boolean   @default(false) @map("is_read")
  readAt        DateTime? @map("read_at") @db.Timestamptz()
  notifiedDate  DateTime  @default(now()) @map("notified_date") @db.Timestamptz()

  @@index([userId, isRead])
  @@index([contractId, daysRemaining])
  @@map("contract_notifications")
}

// ==========================================
// 6. SUPPORT & CONTACT CHANNEL (ข้อ 6: ช่องทางติดต่อแจ้งปรับปรุง/แก้ไขปัญหา)
// ==========================================

/// ตารางแสดงข้อมูลช่องทางติดต่อผู้ดูแลระบบ (เบอร์โทร, อีเมล, WhatsApp, Line ฯลฯ)
model SystemContactChannel {
  id          Int      @id @default(autoincrement())
  channelName String   @map("channel_name") // เช่น "ฝ่าย IT Support", "สายด่วนแจ้งปัญหา", "WhatsApp"
  contactInfo String   @map("contact_info") // เบอร์โทร, ลิงก์, หรืออีเมล
  description String? // เวลาทำการ หรือรายละเอียดเพิ่มเติม
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("system_contact_channels")
}

/// ตารางสำหรับให้ User ส่งเรื่องแจ้งปรับปรุงหรือแก้ไขปัญหาในระบบโดยตรง
model SupportTicket {
  id            String         @id @default(uuid()) @db.Uuid
  ticketNumber  String         @unique @map("ticket_number") // เช่น TKT-202610-001
  subject       String
  description   String
  attachmentUrl String?        @map("attachment_url") // ภาพหน้าจอปัญหา (ถ้ามี)
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  adminNote     String?        @map("admin_note")

  reportedById String  @map("reported_by_id") @db.Uuid
  reportedBy   User    @relation("TicketReporter", fields: [reportedById], references: [id])
  assignedToId String? @map("assigned_to_id") @db.Uuid
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id])

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status, priority])
  @@index([reportedById])
  @@map("support_tickets")
}

// ==========================================
// 7. AUDIT LOG (ประวัติการใช้งานระบบทั้งหมด)
// ==========================================

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  contractId String?   @map("contract_id") @db.Uuid
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  action    AuditAction
  oldValues Json?       @map("old_values") // เก็บค่าก่อนแก้ไข (JSONB)
  newValues Json?       @map("new_values") // เก็บค่าหลังแก้ไข (JSONB)
  ipAddress String?     @map("ip_address")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  @@index([contractId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
