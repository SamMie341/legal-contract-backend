# คัดลอกเป็น .env.docker แล้วแก้ค่าก่อน deploy  (cp .env.docker.example .env.docker)
# รันด้วย: docker compose --env-file .env.docker up -d --build

# Postgres ที่ติดตั้งบนเครื่อง host (ใช้ host.docker.internal แทน localhost)
# ถ้ารหัสผ่านมีอักขระพิเศษ (@ : / # ?) ต้อง URL-encode
DATABASE_URL="postgresql://USER:PASSWORD@host.docker.internal:5432/legal_contract?schema=public"
API_PORT=3001

# ตัวแปรของ app
JWT_SECRET="super_secret_key_legal_contract_management_system_2026"
HRM_SYNC_USERNAME=Ton
HRM_SYNC_PASSWORD=HRM1234

# Upload directories (ค่าเริ่มต้นใน container)
UPLOAD_DIR=/app/uploads/contracts
UPLOAD_DIR_LEGAL_DOCS=/app/uploads/legal-documents
UPLOAD_DIR_LEGAL_CASES=/app/uploads/legal-cases
TICKET_UPLOAD_DIR=/app/uploads/tickets
